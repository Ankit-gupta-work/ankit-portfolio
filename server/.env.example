# Copy this file to server/.env and fill in real values.
# The API works with any OpenAI-compatible /chat/completions endpoint — no code changes needed.

# --- Required ---

# Base URL of the provider's OpenAI-compatible API (no trailing slash, no /chat/completions suffix).
AI_BASE_URL=https://api.groq.com/openai/v1

# API key for that provider. Never committed, never sent to the browser.
AI_API_KEY=your-api-key-here

# Model name as the provider expects it.
AI_MODEL=llama-3.3-70b-versatile

# --- Optional ---

# Max tokens per answer. Default: 400
AI_MAX_TOKENS=400

# Sampling temperature. Default: 0.3
AI_TEMPERATURE=0.3

# Comma-separated list of origins allowed to call this API. Default: http://localhost:4200
ALLOWED_ORIGINS=http://localhost:4200

# Redis connection string for shared, multi-instance rate limiting. If unset, the API falls back
# to an in-memory limiter (per-process, works with zero setup).
REDIS_URL=localhost:6379

# Requests allowed per visitor IP per hour. Default: 15
RATE_LIMIT_PER_HOUR=15

# ---------------------------------------------------------------------------
# Example values for common providers — uncomment the block you're using.
# ---------------------------------------------------------------------------

# Groq (fast, generous free tier):
#   AI_BASE_URL=https://api.groq.com/openai/v1
#   AI_MODEL=llama-3.3-70b-versatile

# OpenRouter (many hosted models behind one key):
#   AI_BASE_URL=https://openrouter.ai/api/v1
#   AI_MODEL=meta-llama/llama-3.1-8b-instruct:free

# Ollama (local, no API key needed — any non-empty string works for AI_API_KEY):
#   AI_BASE_URL=http://localhost:11434/v1
#   AI_MODEL=llama3.2
#   AI_API_KEY=ollama
